---
title: CMN — Password Reset Flow (Token URL)
---
sequenceDiagram
    actor U as User
    participant FE as Frontend<br/>(web-app reset-password page)
    participant GW as Web Gateway
    participant AC as AuthController
    participant AS as AuthAppService
    participant ENC as IStringEncryptionService
    participant R as Redis
    participant EV as Local Event Bus
    participant EH as RecoveryPasswordEventHandler
    participant MT as MailTemplateAppService
    participant SMTP as SMTP (MailKit)
    participant DB as SQL Server

    rect rgb(240, 248, 255)
        Note over U,SMTP: Phase 1 — Request Password Recovery
        U->>FE: Enter email on forgot-password form
        FE->>GW: POST /cmn/administration-service/api/auth/request-password-recovery<br/>Body: { Email }<br/>[AllowAnonymous]
        GW->>AC: Forward
        AC->>AS: RequestPasswordRecoveryAsync(email)

        AS->>DB: Find IdentityUser WHERE Email = @email
        DB-->>AS: IdentityUser { Id, Name, UserName }

        AS->>AS: rawToken = Guid.NewGuid().ToString()
        AS->>ENC: Encrypt(rawToken)
        ENC-->>AS: encryptedToken

        AS->>R: SET PasswordReset:{rawToken}<br/>= { IsUsed: false, UserId, ExpiredTime: now+24h, Email }<br/>TTL 24h

        AS->>AS: resetUrl = "{App:ResetPasswordUrl}?token={UrlEncode(encryptedToken)}"
        AS->>EV: Publish RecoveryPasswordEvent<br/>{ Email, ResetUrl, UserId }

        EV->>EH: Handle RecoveryPasswordEvent
        EH->>DB: Find tenant name from ITenantRepository
        EH->>MT: SendEmailAsync(PASSWORD_RECOVERY, email,<br/>{ User.Name, User.UserName, User.TenantName,<br/>PasswordReset.ResetLink, PasswordReset.ExpireHours: 24 })
        MT->>DB: MongoDB — find MailTemplate WHERE Code = "PASSWORD_RECOVERY"
        MT->>MT: Replace ##Group.Field## placeholders
        MT->>SMTP: IEmailSender.SendAsync(to: email, subject, body)
        SMTP-->>U: Email: "Reset your password" (link with token)

        AS-->>AC: void (success)
        AC-->>FE: 200 ApiResult
    end

    rect rgb(240, 255, 240)
        Note over U,SMTP: Phase 2 — Submit New Password
        U->>U: Click link in email<br/>Arrives at /reset-password?token={encryptedToken}
        U->>FE: Enter new password + submit
        FE->>GW: POST /cmn/administration-service/api/auth/reset-password<br/>Body: { Token: urlEncodedEncryptedToken, NewPassword }<br/>[AllowAnonymous]
        GW->>AC: Forward
        AC->>AS: ResetPasswordAsync(token, newPassword)

        AS->>AS: decodedToken = UrlDecode(token)
        AS->>ENC: Decrypt(decodedToken)
        ENC-->>AS: rawToken

        AS->>R: GET PasswordReset:{rawToken}
        R-->>AS: { IsUsed, UserId, ExpiredTime, Email }

        AS->>AS: Assert IsUsed == false<br/>(throw: token already used)
        AS->>AS: Assert ExpiredTime > now<br/>(throw: token expired)

        AS->>DB: IdentityManager.RemovePasswordAsync(user)
        AS->>DB: IdentityManager.AddPasswordAsync(user, newPassword)

        AS->>R: UPDATE PasswordReset:{rawToken}.IsUsed = true

        AS->>EV: Publish PasswordResetSuccessEvent<br/>{ UserId, ResetTime: now }

        EV->>EH: Handle PasswordResetSuccessEvent
        EH->>MT: SendEmailAsync(PASSWORD_RECOVERY_SUCCESS, email,<br/>{ User.Name, User.UserName, User.TenantName,<br/>PasswordReset.Time, PasswordReset.Date })
        MT->>SMTP: IEmailSender.SendAsync (confirmation email)
        SMTP-->>U: Email: "Password reset successfully"

        AS-->>AC: void
        AC-->>FE: 200 ApiResult
        FE-->>U: Redirect to login
    end
